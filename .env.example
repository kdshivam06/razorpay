# RecoveryOS Environment Variables

# Razorpay credentials (test mode only)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Webhook signing secrets (current + previous for rotation)
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_SECRET_PREVIOUS=

# Database
DATABASE_URL=postgresql://recovery:recovery@localhost:5432/recovery_os
REDIS_URL=redis://localhost:6379/0

# Docker Compose Postgres credentials (must match DATABASE_URL above)
POSTGRES_USER=recovery
POSTGRES_PASSWORD=recovery
POSTGRES_DB=recovery_os

# Google Gemini (NLP)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (optional — Track F.1 FAST_CLASSIFY path).
# Absent/unset is fine: raw failure signals fall back to deterministic rules.
GROQ_API_KEY=

# Application
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata